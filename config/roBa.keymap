#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

// HID positions for a Windows Japanese (106/109) host layout.
#define JIS_AT LEFT_BRACKET
#define JIS_LBKT RIGHT_BRACKET
#define JIS_RBKT NON_US_HASH
#define JIS_LBRC LS(JIS_LBKT)
#define JIS_RBRC LS(JIS_RBKT)
#define JIS_LPAR LS(N8)
#define JIS_RPAR LS(N9)
#define JIS_COLON SQT
#define JIS_ASTERISK LS(JIS_COLON)
#define JIS_PLUS LS(SEMICOLON)
#define JIS_EQUAL LS(MINUS)
#define JIS_AMPERSAND LS(N6)
#define JIS_APOSTROPHE LS(N7)
#define JIS_DQUOTE LS(N2)
#define JIS_CARET EQUAL
#define JIS_GRAVE LS(JIS_AT)
#define JIS_TILDE LS(JIS_CARET)
#define JIS_BACKSLASH INT1
#define JIS_UNDERSCORE LS(JIS_BACKSLASH)
#define JIS_PIPE LS(INT3)

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <300>;
    flavor = "balanced";
};

&trackball {
    scroll-layers = <6>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

&zip_temp_layer {
    excluded-positions = <
        18 // J
        19 // K
        20 // L
        34 // Ctrl-click
        35 // GUI modifier
        36 // Alt modifier
    >;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
        };

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <40 39>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt_clear_current: bt_clear_current {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
            label = "BT_CLEAR_CURRENT";
        };
    };

    behaviors {
        scroll_lt: scroll_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            label = "SCROLL_LAYER_TAP";
        };

        bt_clear_hold: bt_clear_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&bt_clear_current>, <&none>;
            tapping-term-ms = <1000>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            label = "BT_CLEAR_HOLD";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base - Windows JIS";
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                          &kp Y          &kp U  &scroll_lt 6 I  &kp O    &lt 5 P
&kp A             &kp S         &kp D         &kp F             &kp G        &kp ESC                    &kp EQUAL              &kp H          &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B        &kp TAB                    &kp SEMICOLON          &kp N          &kp M  &kp COMMA      &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 INT_HENKAN    &lt 2 SPACE  &lt 3 INT_MUHENKAN         &kp BACKSPACE          &lt 1 ENTER                                  &kp BACKSPACE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            display-name = "Symbols - JIS";
            bindings = <
&kp EXCLAMATION        &kp QUESTION      &kp JIS_AT    &kp HASH              &kp JIS_ASTERISK                       &trans  &kp JIS_LBKT   &kp JIS_RBKT      &kp JIS_LPAR          &kp JIS_RPAR
&kp JIS_UNDERSCORE     &kp JIS_EQUAL     &kp JIS_COLON &kp SEMICOLON         &kp JIS_BACKSLASH  &trans  &kp COMMA  &kp DOT        &kp JIS_LBRC      &kp JIS_RBRC          &kp LESS_THAN          &kp GREATER_THAN
&mt LEFT_SHIFT MINUS   &kp SLASH         &kp JIS_PIPE  &kp JIS_AMPERSAND     &kp JIS_CARET     &kp DOLLAR  &kp PERCENT  &kp JIS_TILDE  &kp JIS_APOSTROPHE  &kp JIS_DQUOTE     &kp SLASH              &kp JIS_GRAVE
&trans                 &trans            &trans        &trans                &trans         &trans    &trans     &trans                                                                          &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            display-name = "Numbers";
            bindings = <
&kp MINUS         &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9      &kp JIS_PLUS                           &trans       &kp F7        &kp F8        &kp F9        &kp F10
&kp SLASH         &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6      &kp JIS_ASTERISK  &kp COMMA      &trans       &trans        &kp F4        &kp F5        &kp F6        &kp F11
&kp NUMBER_0      &kp NUMBER_1      &kp NUMBER_2      &kp NUMBER_3      &kp PERIOD        &kp JIS_EQUAL  &trans       &trans        &kp F1        &kp F2        &kp F3        &kp F12
&trans            &trans            &trans            &trans            &trans          &trans             &trans       &trans                                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            display-name = "Navigation - Windows";
            bindings = <
&kp ESC    &kp LC(LS(TAB))  &kp PRINTSCREEN &kp LC(TAB)      &kp LC(T)                             &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&kp LC(S)  &kp LC(Z)        &kp LC(X)        &kp LC(C)        &kp LC(V)            &trans      &kp LA(LEFT_ARROW)  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(RIGHT_ARROW)
&trans     &kp LEFT_SHIFT   &kp LC(Y)        &kp LC(W)        &kp DELETE           &trans    &trans              &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans  &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            display-name = "Bluetooth";
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &bt_clear_hold 0 0
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &none
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans    &trans    &trans    &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
